require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/expo-modules-autolinking/scripts/ios/autolinking_manager'

platform :ios, '13.0' # 🔄 Vérifie que la version iOS est bien supportée

install! 'cocoapods', :deterministic_uuids => false

# ✅ Ajout pour éviter les erreurs de cache entre les versions
def clean_up_pods_cache!
  system("rm -rf ~/Library/Caches/CocoaPods && rm -rf Pods && pod deintegrate && pod install")
end

target 'Tattoo' do
  use_expo_modules!({
    modules: ['expo-modules-core']
  })

  config = use_native_modules!

  use_frameworks! :static  # ✅ Correction : `:linkage => :static` était incorrect

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => false,  # ❌ Désactivation temporaire de Hermes si problème
    :app_path => "#{Pod::Config.instance.installation_root}/..",
  )

  # 🚀 Activation de Flipper uniquement si nécessaire (optionnel)
  # Désactiver si tu n'as pas besoin de debugging avancé
  flipper_config = ENV['FLIPPER_ENABLE'] == '1' ? { 'Flipper' => '0.162.0' } : {}
  use_flipper!(flipper_config) if ENV['FLIPPER_ENABLE'] == '1'

  post_install do |installer|
    react_native_post_install(installer)

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
      end
    end

    # ✅ Ajout pour éviter les erreurs de linkage sur Xcode 15+
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
    end
  end
end